# Copia como .env en la raíz (Bun lo lee solo al arrancar) y deja el archivo
# solo para el usuario del servicio: chmod 600 .env

PORT=4330

# Aviso por correo de cada solicitud de demo, por el SMTP de Resend. Sin
# SMTP_HOST no se envía nada (la solicitud igual se guarda en
# data/solicitudes-demo.jsonl).
SMTP_HOST=smtp.resend.com
# 465 con TLS directo. Si el VPS bloquea ese puerto, Resend también escucha en 2465.
SMTP_PORT=465
SMTP_SECURE=true
# En Resend el usuario es literalmente «resend» y la contraseña es una API key
# (re_…) con permiso «Sending access».
SMTP_USER=resend
SMTP_PASS=
# A quién llega el aviso y quién lo envía. El remitente tiene que ser de un
# dominio verificado en Resend (rcgpty.com).
DEMO_CORREO_PARA=zrivera@rcgpty.com
DEMO_CORREO_DE="RCG Softrix <rcgsoftrix@rcgpty.com>"

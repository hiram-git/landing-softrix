# Copia como .env en la raíz (Bun lo lee solo al arrancar) y deja el archivo
# solo para el usuario del servicio: chmod 600 .env

PORT=4330

# Aviso por correo de cada solicitud de demo. Sin SMTP_HOST no se envía nada
# (la solicitud igual se guarda en data/solicitudes-demo.jsonl).
# El servidor de salida del correo de rcgpty.com (lo da el proveedor del dominio).
SMTP_HOST=
SMTP_PORT=587
# true con el puerto 465 (TLS directo); con 587 se negocia STARTTLS.
SMTP_SECURE=false
SMTP_USER=rcgsoftrix@rcgpty.com
SMTP_PASS=
# A quién llega el aviso (por defecto, el correo de contacto del sitio) y quién lo envía.
DEMO_CORREO_PARA=zrivera@rcgpty.com
DEMO_CORREO_DE="RCG Softrix <rcgsoftrix@rcgpty.com>"

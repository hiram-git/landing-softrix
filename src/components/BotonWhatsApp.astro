---
import { enlaceWhatsApp } from "@/config/site";
import Icono from "./Icono.astro";
---

<a
  class="wa"
  data-wa
  href={enlaceWhatsApp()}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
>
  <Icono nombre="whatsapp" />
</a>

<style>
  .wa {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #1f9e55;
    color: #fff;
    box-shadow:
      0 0 0 3px var(--pintura),
      0 10px 24px -8px rgb(0 0 0 / 0.55);
    transition:
      transform var(--dur-media) var(--ease-salida),
      opacity var(--dur-corta) ease;
  }
  .wa[data-oculto] {
    opacity: 0;
    transform: translateY(1.5rem) scale(0.9);
    pointer-events: none;
  }
  .wa:hover {
    transform: translateY(-2px);
  }
  .wa :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>

<script>
  // Mientras una zona con su propio botón de WhatsApp está a la vista, el flotante
  // sobra y además taparía texto en el celular.
  const boton = document.querySelector<HTMLElement>("[data-wa]");
  const zonas = document.querySelectorAll("[data-oculta-wa]");
  if (boton && zonas.length) {
    const visibles = new Set<Element>();
    const actualizar = () => {
      const oculto = visibles.size > 0;
      boton.toggleAttribute("data-oculto", oculto);
      if (oculto) {
        boton.setAttribute("tabindex", "-1");
        boton.setAttribute("aria-hidden", "true");
      } else {
        boton.removeAttribute("tabindex");
        boton.removeAttribute("aria-hidden");
      }
    };
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) visibles.add(e.target);
          else visibles.delete(e.target);
        }
        actualizar();
      },
      { rootMargin: "0px 0px -15% 0px" },
    );
    for (const z of zonas) observador.observe(z);
  }
</script>

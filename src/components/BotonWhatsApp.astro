---
import { enlaceWhatsApp } from "@/config/site";
import Icono from "./Icono.astro";
---

<a
  class="wa"
  href={enlaceWhatsApp()}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
>
  <Icono nombre="whatsapp" />
</a>

<style>
  .wa {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #1f9e55;
    color: #fff;
    box-shadow:
      0 0 0 3px var(--pintura),
      0 10px 24px -8px rgb(0 0 0 / 0.55);
    transition: transform var(--dur-corta) var(--ease-salida);
  }
  .wa:hover {
    transform: translateY(-2px);
  }
  .wa svg {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>

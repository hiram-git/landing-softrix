---
import { contacto, type Interes } from "@/data/contacto";
import Button from "./Button.astro";

// Franja de CTA de las páginas de producto (fondo brand-deep, radius-xl).
interface Props {
  title: string;
  apoyo?: string;
  /** La sección clara u oscura dentro de la alternancia de la página. */
  tema?: "light" | "dark";
  /** Producto que el formulario de la portada trae elegido (ver `intereses`). */
  interes?: Interes;
}
const { title, apoyo = "Demo guiada de 30 minutos. Sin tarjeta.", tema, interes } = Astro.props;
const destino = interes ? `/?interes=${encodeURIComponent(interes)}#demo` : "/#demo";
---

<section class="seccion--cta" data-theme={tema} aria-label="Solicitar demo">
  <div class="cta" data-revelar>
    <div class="cta__texto">
      <h2 class="cta__titulo">{title}</h2>
      <p class="cta__apoyo">{apoyo}</p>
    </div>
    <div class="acciones">
      <Button variant="primary" size="lg" arrow href={destino}>Solicitar demo</Button>
      <Button variant="secondary-inverse" size="lg" href={contacto.whatsapp}>
        Escribir por WhatsApp
      </Button>
    </div>
  </div>
</section>

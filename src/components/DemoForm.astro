---
import { contacto, intereses } from "@/data/contacto";
import { LIMITES } from "@/data/demo";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Input from "./Input.astro";

// Formulario de demo de screens/inicio.html: nombre, correo y/o WhatsApp e interés, con
// su estado de éxito. Envía a POST /api/demo; sin JavaScript también funciona
// (envío normal del formulario).
---

<div class="demo" data-demo>
  <form class="demo__form" action="/api/demo" method="post" novalidate data-demo-form>
    <Input name="nombre" label="Nombre" required autocomplete="name" maxlength={LIMITES.nombre} />
    <fieldset class="demo__contacto">
      <legend class="demo__leyenda">¿Cómo te contactamos? Basta con uno.</legend>
      <Input
        name="correo"
        label="Correo"
        type="email"
        inputmode="email"
        autocomplete="email"
        maxlength={LIMITES.correo}
        hint="Te enviamos la confirmación aquí"
      />
      <Input
        name="whatsapp"
        label="WhatsApp"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        maxlength={LIMITES.whatsapp}
        hint="Con o sin +507"
      />
    </fieldset>
    <div class="sx-field">
      <label class="sx-field__label" for="interes">¿Qué te interesa?</label>
      <select id="interes" name="interes" class="sx-select" required>
        <option value="" selected>Elige una opción</option>
        {intereses.map((i) => <option>{i}</option>)}
      </select>
    </div>
    <!-- Trampa para bots: las personas no la ven ni la alcanzan con el teclado. -->
    <div class="demo__trampa" aria-hidden="true">
      <label>Sitio web <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="demo__error" role="alert" hidden data-demo-error>
      <Icon name="alert" />
      <span>
        <span data-demo-error-texto>No pudimos enviar tu solicitud. Inténtalo de nuevo.</span>
        <a href={contacto.whatsapp}>escríbenos por WhatsApp</a>.
      </span>
    </div>
    <div class="demo__pie">
      <div class="demo__nota">Solo usamos tus datos para contactarte.</div>
      <Button variant="primary" size="lg" type="submit" arrow data-demo-enviar>Solicitar demo</Button>
    </div>
  </form>

  <div class="demo__exito" hidden tabindex="-1" data-demo-exito>
    <div><Badge tone="success" pill icon="check">Solicitud enviada</Badge></div>
    <div class="demo__exito-titulo">Listo. Te contactamos en un día hábil.</div>
    <div class="demo__exito-texto">
      Si prefieres no esperar, escríbenos ahora al WhatsApp {contacto.whatsappVisible} o llama al{" "}
      {contacto.oficina}.
    </div>
    <div class="demo__exito-acciones">
      <Button variant="whatsapp" href={contacto.whatsapp}>Escribir por WhatsApp</Button>
      <Button variant="ghost" data-demo-otra>Enviar otra solicitud</Button>
    </div>
  </div>
</div>

<style>
  .demo__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-000);
  }
  .demo__contacto {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .demo__leyenda {
    margin-bottom: var(--space-3);
    padding: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .demo__pie {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }
  .demo__trampa {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .demo__error a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
  }
  .demo__nota {
    font-size: 12px;
    line-height: 16px;
    color: var(--ink-muted);
  }
  .demo__error {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--danger-soft);
    color: var(--danger);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
  }
  .demo__error[hidden] {
    display: none;
  }
  .demo__error :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .demo__exito {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
    border: 1px solid var(--success);
    border-radius: var(--radius-lg);
    background: var(--success-soft);
  }
  .demo__exito[hidden] {
    display: none;
  }
  .demo__exito-titulo {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 34px;
    font-weight: 600;
    color: var(--ink);
  }
  .demo__exito-texto {
    font-size: 16px;
    line-height: 24px;
    color: var(--ink-muted);
  }
  .demo__exito-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (max-width: 959.98px) {
    .demo__form,
    .demo__exito {
      padding: var(--space-6);
    }
  }
</style>

<script>
  import { intereses } from "@/data/contacto";
  import { type CampoContacto, erroresContacto } from "@/data/demo";

  const MENSAJES = {
    nombre: "Escribe tu nombre",
    interes: "Elige qué te interesa",
  } as const;
  const ESPERA_MAXIMA = 15000;

  // Mensaje del aviso según lo que falló; el enlace a WhatsApp va siempre al lado.
  function mensajeDeFallo(estado: number | "red" | "tiempo"): string {
    if (estado === "red") return "Parece que no tienes conexión. Revisa tu internet e inténtalo de nuevo, o";
    if (estado === "tiempo") return "El envío tardó demasiado. Inténtalo de nuevo en un momento, o";
    if (estado === 422) return "Revisa los datos del formulario e inténtalo de nuevo, o";
    if (estado === 429) return "Recibimos varias solicitudes seguidas desde tu conexión. Espera unos minutos, o";
    return "No pudimos enviar tu solicitud. Inténtalo de nuevo en un momento, o";
  }

  const raiz = document.querySelector<HTMLElement>("[data-demo]");
  const form = raiz?.querySelector<HTMLFormElement>("[data-demo-form]");
  const exito = raiz?.querySelector<HTMLElement>("[data-demo-exito]");
  const aviso = raiz?.querySelector<HTMLElement>("[data-demo-error]");
  const enviar = raiz?.querySelector<HTMLButtonElement>("[data-demo-enviar]");

  // Mismo markup que Input.astro con `error`: borde danger, icono y texto.
  function marcar(campo: HTMLInputElement | HTMLSelectElement, mensaje: string | null) {
    const caja = campo.closest(".sx-field");
    if (!caja) return;
    caja.querySelector(".sx-field__error")?.remove();
    const pista = caja.querySelector<HTMLElement>(".sx-field__hint");
    caja.classList.toggle("sx-field--error", Boolean(mensaje));
    if (!mensaje) {
      campo.removeAttribute("aria-invalid");
      if (pista) {
        pista.hidden = false;
        campo.setAttribute("aria-describedby", pista.id);
      } else campo.removeAttribute("aria-describedby");
      return;
    }
    const error = document.createElement("div");
    error.className = "sx-field__error";
    error.id = `${campo.id}-err`;
    const icono = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    icono.setAttribute("viewBox", "0 0 24 24");
    icono.setAttribute("aria-hidden", "true");
    icono.innerHTML = '<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>';
    error.append(icono, mensaje);
    if (pista) pista.hidden = true;
    caja.append(error);
    campo.setAttribute("aria-invalid", "true");
    campo.setAttribute("aria-describedby", error.id);
  }

  const textoAviso = aviso?.querySelector<HTMLElement>("[data-demo-error-texto]");

  if (form && exito && aviso && enviar) {
    const select = form.elements.namedItem("interes") as HTMLSelectElement;
    // Quien llega desde una página de producto trae su interés en ?interes=.
    const pedido = new URLSearchParams(location.search).get("interes");
    if (pedido && (intereses as readonly string[]).includes(pedido)) select.value = pedido;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      aviso.hidden = true;
      const datos = Object.fromEntries(new FormData(form)) as Record<string, string>;

      // En el orden de la pantalla, para enfocar el primero que falla.
      const errores: [string, string | null][] = [
        ["nombre", String(datos.nombre ?? "").trim() ? null : MENSAJES.nombre],
        ...Object.entries(erroresContacto(datos.correo, datos.whatsapp)),
        ["interes", datos.interes ? null : MENSAJES.interes],
      ];
      let primero: HTMLInputElement | HTMLSelectElement | null = null;
      for (const [nombre, mensaje] of errores) {
        const campo = form.elements.namedItem(nombre) as HTMLInputElement | HTMLSelectElement;
        marcar(campo, mensaje);
        if (mensaje && !primero) primero = campo;
      }
      if (primero) {
        primero.focus();
        return;
      }

      enviar.disabled = true;
      enviar.setAttribute("aria-busy", "true");
      // Sin respuesta en 15 s se corta el envío: el botón no queda bloqueado para siempre.
      const corte = new AbortController();
      const reloj = window.setTimeout(() => corte.abort(), ESPERA_MAXIMA);
      try {
        const r = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(datos),
          signal: corte.signal,
        });
        if (!r.ok) throw r.status;
        form.hidden = true;
        exito.hidden = false;
        exito.focus();
        document.dispatchEvent(new CustomEvent("demo:enviada", { detail: exito }));
      } catch (fallo) {
        const estado =
          typeof fallo === "number"
            ? fallo
            : corte.signal.aborted
              ? "tiempo"
              : navigator.onLine === false || fallo instanceof TypeError
                ? "red"
                : 0;
        if (textoAviso) textoAviso.textContent = mensajeDeFallo(estado);
        aviso.hidden = false;
      } finally {
        window.clearTimeout(reloj);
        enviar.disabled = false;
        enviar.removeAttribute("aria-busy");
      }
    });

    // El error de un campo se borra en cuanto la persona lo corrige. Correo y WhatsApp van
    // juntos: escribir en uno resuelve el «deja al menos uno» del otro.
    form.addEventListener("input", (e) => {
      const campo = e.target as HTMLInputElement;
      if (campo.getAttribute("aria-invalid") === "true" && campo.value.trim()) marcar(campo, null);
      if (campo.name === "correo" || campo.name === "whatsapp") {
        const otro = form.elements.namedItem(campo.name === "correo" ? "whatsapp" : "correo") as HTMLInputElement;
        const errores = erroresContacto(
          (form.elements.namedItem("correo") as HTMLInputElement).value,
          (form.elements.namedItem("whatsapp") as HTMLInputElement).value,
        );
        if (otro.getAttribute("aria-invalid") === "true" && !errores[otro.name as CampoContacto]) marcar(otro, null);
      }
    });
    select.addEventListener("change", () => select.value && marcar(select, null));

    raiz?.querySelector("[data-demo-otra]")?.addEventListener("click", () => {
      form.reset();
      exito.hidden = true;
      form.hidden = false;
      (form.elements.namedItem("nombre") as HTMLInputElement).focus();
    });
  }
</script>

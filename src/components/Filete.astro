---
// Filete: la línea fina con remate en espiral de los buses pintados a mano.
interface Props {
  voltear?: boolean;
  class?: string;
}
const { voltear = false, class: clase } = Astro.props;
const id = `cromo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={["filete", clase, { "filete--volteado": voltear }]}
  viewBox="0 0 260 44"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--cromo-oscuro)" stop-opacity="0" />
      <stop offset="0.35" stop-color="var(--cromo-medio)" />
      <stop offset="0.7" stop-color="var(--cromo-claro)" />
      <stop offset="1" stop-color="var(--cromo-medio)" />
    </linearGradient>
  </defs>
  <g stroke={`url(#${id})`} stroke-linecap="round">
    <path
      stroke-width="1.6"
      d="M0 22H176c16 0 24-12 37-12 12 0 19 9 15 17-4 7-15 7-16-1-1-6 6-8 9-4"
    />
    <path stroke-width="1" d="M0 28H168c13 0 20 6 30 7" />
  </g>
  <path fill="var(--rojo)" d="M246 22l5-5 5 5-5 5Z" />
</svg>

<style>
  .filete {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .filete--volteado {
    transform: scaleX(-1);
  }
</style>

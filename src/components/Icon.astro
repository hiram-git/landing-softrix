---
// Iconos de components.reference.js (arrow, alert, check, chevron, chat) y los
// Lucide que usan las pantallas. Sin atributos de trazo: el CSS del componente
// que los contiene decide tamaño y trazo.
const trazos = {
  arrow: ["M5 12h14M13 6l6 6-6 6"],
  alert: ["M12 8v4M12 16h.01"],
  check: ["M5 12l4 4L19 7"],
  chevron: ["M6 9l6 6 6-6"],
  chat: ["M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"],
  box: ["M21 8 12 3 3 8l9 5 9-5z", "M3 8v8l9 5 9-5V8", "M12 13v8"],
  users: [
    "M9 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
    "M2 21a7 7 0 0 1 14 0",
    "M17 4a4 4 0 0 1 0 8",
    "M22 21a7 7 0 0 0-5-6.7",
  ],
  gate: [
    "M4 21V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16",
    "M2 21h20",
    "M9 21v-6h6v6",
    "M15 11h.01",
  ],
  pen: ["M12 20h9", "M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"],
  calc: [
    "M4 3h16v18H4z",
    "M8 7h8",
    "M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 19h.01M12 19h.01M16 19h.01",
  ],
  mark: ["M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z"],
  doc: ["M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z", "M14 2v6h6", "M8 13h8M8 17h8"],
  menu: ["M4 7h16M4 12h16M4 17h16"],
  close: ["M6 6l12 12M18 6L6 18"],
} as const;

export type IconName = keyof typeof trazos;

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: clase } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" class={clase}>
  {name === "alert" && <circle cx="12" cy="12" r="9" />}
  {trazos[name].map((d) => <path d={d} />)}
</svg>

---
import { enlaceWhatsApp, productos, sitio } from "@/config/site";
import Filete from "./Filete.astro";
import Icono from "./Icono.astro";

const anio = new Date().getFullYear();
---

<footer class="pie pintura">
  <div class="contenedor">
    <div class="pie__filetes" aria-hidden="true">
      <Filete />
      <Filete voltear />
    </div>

    <div class="pie__rejilla">
      <div class="pie__marca">
        <img src="/brand/logo-rcg-softrix-claro.png" alt="RC Group Softrix" width="1282" height="180" />
        <p>{sitio.descripcion}</p>
      </div>

      <nav aria-label="Productos" class="pie__columna">
        <h2>Productos</h2>
        <ul>
          {productos.map((p) => <li><a href={`/${p.slug}`}>{p.nombre}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Empresa" class="pie__columna">
        <h2>Empresa</h2>
        <ul>
          <li><a href="/distribuidores">Distribuidores</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>

      <div class="pie__columna">
        <h2>Habla con ventas</h2>
        <ul>
          <li>
            <a href={enlaceWhatsApp()} rel="noopener" target="_blank">
              <Icono nombre="whatsapp" />
              {sitio.whatsapp.visible}
            </a>
          </li>
          <li>
            <a href={`mailto:${sitio.correo}`}>
              <Icono nombre="correo" />
              {sitio.correo}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="pie__legal">
      © {anio} {sitio.empresa} · {sitio.nombre}. Hecho en Panamá.
    </p>
  </div>
</footer>

<style>
  .pie {
    padding-block: 3rem 2rem;
    overflow: hidden;
  }

  .pie__filetes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .pie__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .pie__marca img {
    height: 1.6rem;
    width: auto;
  }

  .pie__marca p {
    margin-top: 1.25rem;
    max-width: 36ch;
    color: var(--sobre-pintura-2);
    font-size: 0.975rem;
  }

  .pie__columna h2 {
    font-family: var(--f-letrero);
    font-weight: 400;
    font-stretch: 100%;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--cromo-claro);
    margin-bottom: 1rem;
  }

  .pie__columna ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .pie__columna a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sobre-pintura);
    text-decoration: none;
    font-size: 0.975rem;
    overflow-wrap: anywhere;
  }

  .pie__columna a:hover {
    color: var(--cabina);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pie__columna :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }

  .pie__legal {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hilo-pintura);
    color: var(--sobre-pintura-2);
    font-size: 0.875rem;
  }

  @media (max-width: 820px) {
    .pie__rejilla {
      grid-template-columns: 1fr 1fr;
    }
    .pie__marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .pie__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// Escena Three.js del hero: una «red de cumplimiento», esfera de puntos
// enlazados en malla (azul marino, esmeralda y cian) con dos anillos orbitales
// y satélites que los recorren. Rota sola y se inclina hacia el puntero.
//
// Three.js se carga aparte y solo cuando el navegador está libre, así el
// primer pintado y la cascada GSAP del hero no esperan por él. Sin WebGL
// quedan los chips y las órbitas en CSS; con «reducir movimiento» se pinta
// un solo cuadro quieto.
const chips = [
  { texto: "Facturación electrónica activa", pos: "a" },
  { texto: "Certificado de firma vigente", pos: "b" },
  { texto: "Equipo homologado por la DGI", pos: "c" },
];
---

<div
  class="escena"
  data-escena
  role="img"
  aria-label="Red de cumplimiento: facturación electrónica, firma digital y equipos homologados conectados"
>
  <div class="escena__resplandor" aria-hidden="true"></div>
  <div class="escena__orbitas" aria-hidden="true"><i></i><i></i></div>
  <canvas class="escena__canvas" data-escena-canvas aria-hidden="true"></canvas>
  {
    chips.map((c) => (
      <div class:list={["escena__chip", `escena__chip--${c.pos}`]}>
        <span class="escena__ok" aria-hidden="true">✓</span>
        {c.texto}
      </div>
    ))
  }
</div>

<style>
  .escena {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }
  .escena__resplandor {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, rgba(6, 182, 212, 0.18), transparent 70%),
      radial-gradient(closest-side at 30% 35%, rgba(16, 185, 129, 0.16), transparent 60%);
    filter: blur(18px);
  }
  .escena__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }
  .escena[data-lista] .escena__canvas {
    opacity: 1;
  }
  /* Respaldo sin WebGL: dos órbitas en CSS detrás de los chips. */
  .escena__orbitas {
    position: absolute;
    inset: 10%;
    display: none;
  }
  .escena--sin-webgl .escena__orbitas {
    display: block;
  }
  .escena__orbitas i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(6, 182, 212, 0.45);
    transform: rotateX(68deg);
  }
  .escena__orbitas i + i {
    inset: 18%;
    border-color: rgba(16, 185, 129, 0.45);
    transform: rotateX(68deg) rotateZ(50deg);
  }
  .escena__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--c-borde);
    border-radius: 999px;
    box-shadow: var(--sombra);
    font: 600 0.82rem/1 var(--f-texto);
    color: var(--c-marino);
    white-space: nowrap;
    backdrop-filter: blur(6px);
    animation: flotar 7s ease-in-out infinite;
  }
  .escena__ok {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--c-esmeralda-suave);
    color: var(--c-esmeralda);
    font-size: 0.7rem;
    font-weight: 800;
  }
  .escena__chip--a {
    top: 9%;
    left: -4%;
  }
  .escena__chip--b {
    top: 46%;
    right: -6%;
    animation-delay: -2.4s;
  }
  .escena__chip--c {
    bottom: 10%;
    left: 6%;
    animation-delay: -4.8s;
  }
  @keyframes flotar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .escena__chip {
      animation: none;
    }
  }
  @media (max-width: 900px) {
    .escena {
      width: min(100%, 420px);
    }
    .escena__chip {
      font-size: 0.76rem;
    }
    .escena__chip--a {
      left: 0;
    }
    .escena__chip--b {
      right: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const contenedor = document.querySelector<HTMLElement>("[data-escena]");
  const canvas = contenedor?.querySelector<HTMLCanvasElement>("[data-escena-canvas]");

  const hayWebGL = () => {
    try {
      const c = document.createElement("canvas");
      return Boolean(c.getContext("webgl2") ?? c.getContext("webgl"));
    } catch {
      return false;
    }
  };

  // Espera a que el navegador esté libre: la cascada del hero va primero.
  const cuandoLibre = () =>
    new Promise<void>((listo) => {
      if ("requestIdleCallback" in window) {
        (window as Window).requestIdleCallback(() => listo(), { timeout: 1500 });
      } else {
        setTimeout(listo, 400);
      }
    });

  async function iniciar(cont: HTMLElement, lienzo: HTMLCanvasElement) {
    if (!hayWebGL()) {
      cont.classList.add("escena--sin-webgl");
      return;
    }
    const reducir = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fino = matchMedia("(pointer: fine)").matches;

    await cuandoLibre();
    const {
      Scene,
      PerspectiveCamera,
      WebGLRenderer,
      Group,
      BufferGeometry,
      Float32BufferAttribute,
      Points,
      PointsMaterial,
      LineSegments,
      LineBasicMaterial,
      Mesh,
      MeshBasicMaterial,
      TorusGeometry,
      SphereGeometry,
      IcosahedronGeometry,
      Color,
    } = await import("three");

    // ── Escena, cámara y renderizador ────────────────────────────────────
    const escena = new Scene();
    const camara = new PerspectiveCamera(32, 1, 0.1, 50);
    camara.position.set(0, 0, 7.6); // lo bastante lejos para que las órbitas quepan enteras
    const renderer = new WebGLRenderer({
      canvas: lienzo,
      alpha: true,
      antialias: true,
      powerPreference: "high-performance",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, fino ? 2 : 1.5));
    renderer.setClearColor(0x000000, 0);

    const marino = new Color("#16305a");
    const esmeralda = new Color("#10b981");
    const cian = new Color("#06b6d4");

    // ── Esfera de puntos (distribución de Fibonacci) ─────────────────────
    const N = 900;
    const RADIO = 1.6;
    const posiciones = new Float32Array(N * 3);
    const colores = new Float32Array(N * 3);
    const dorado = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < N; i++) {
      const y = 1 - (i / (N - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const th = dorado * i;
      posiciones[i * 3] = Math.cos(th) * r * RADIO;
      posiciones[i * 3 + 1] = y * RADIO;
      posiciones[i * 3 + 2] = Math.sin(th) * r * RADIO;
      // Un 14 % esmeralda y un 8 % cian: puntos «activos» en la red.
      const azar = (i * 7919) % 100;
      const c = azar < 14 ? esmeralda : azar < 22 ? cian : marino;
      colores[i * 3] = c.r;
      colores[i * 3 + 1] = c.g;
      colores[i * 3 + 2] = c.b;
    }
    const geoPuntos = new BufferGeometry();
    geoPuntos.setAttribute("position", new Float32BufferAttribute(posiciones, 3));
    geoPuntos.setAttribute("color", new Float32BufferAttribute(colores, 3));
    const puntos = new Points(
      geoPuntos,
      new PointsMaterial({
        size: 0.055,
        vertexColors: true,
        transparent: true,
        opacity: 0.95,
        sizeAttenuation: true,
        depthWrite: false,
      }),
    );

    // ── Malla: cada punto se enlaza con sus vecinos cercanos ─────────────
    const UMBRAL2 = 0.3 * 0.3;
    const segmentos: number[] = [];
    for (let i = 0; i < N; i++) {
      const ax = posiciones[i * 3];
      const ay = posiciones[i * 3 + 1];
      const az = posiciones[i * 3 + 2];
      for (let j = i + 1; j < N; j++) {
        const dx = ax - posiciones[j * 3];
        const dy = ay - posiciones[j * 3 + 1];
        const dz = az - posiciones[j * 3 + 2];
        if (dx * dx + dy * dy + dz * dz < UMBRAL2) {
          segmentos.push(ax, ay, az, posiciones[j * 3], posiciones[j * 3 + 1], posiciones[j * 3 + 2]);
        }
      }
    }
    const geoLineas = new BufferGeometry();
    geoLineas.setAttribute("position", new Float32BufferAttribute(segmentos, 3));
    const lineas = new LineSegments(
      geoLineas,
      new LineBasicMaterial({ color: marino, transparent: true, opacity: 0.13, depthWrite: false }),
    );

    // Núcleo: icosaedro en alambre, apenas visible, para dar profundidad.
    const nucleo = new Mesh(
      new IcosahedronGeometry(1.12, 2),
      new MeshBasicMaterial({ color: cian, wireframe: true, transparent: true, opacity: 0.08 }),
    );

    const mundo = new Group();
    mundo.add(puntos, lineas, nucleo);
    escena.add(mundo);

    // ── Anillos orbitales y satélites ────────────────────────────────────
    const anillos = new Group();
    const ORBITA = 2.05;
    const hacerAnillo = (color: InstanceType<typeof Color>, rx: number, ry: number) => {
      const anillo = new Mesh(
        new TorusGeometry(ORBITA, 0.009, 8, 180),
        new MeshBasicMaterial({ color, transparent: true, opacity: 0.5 }),
      );
      anillo.rotation.set(rx, ry, 0);
      anillos.add(anillo);
      return anillo;
    };
    const anilloA = hacerAnillo(cian, Math.PI / 2 + 0.38, 0.1);
    const anilloB = hacerAnillo(esmeralda, Math.PI / 2 - 0.42, 0.7);
    const satelites = [
      { padre: anilloA, fase: 0, vel: 0.36, color: esmeralda },
      { padre: anilloA, fase: Math.PI, vel: 0.36, color: cian },
      { padre: anilloB, fase: 1.1, vel: -0.29, color: cian },
    ].map((s) => {
      const malla = new Mesh(new SphereGeometry(0.05, 14, 14), new MeshBasicMaterial({ color: s.color }));
      s.padre.add(malla);
      return { ...s, malla };
    });
    escena.add(anillos);

    // ── Tamaño ───────────────────────────────────────────────────────────
    const medir = () => {
      const w = Math.max(1, cont.clientWidth);
      const h = Math.max(1, cont.clientHeight);
      renderer.setSize(w, h, false);
      camara.aspect = w / h;
      camara.updateProjectionMatrix();
    };
    medir();
    new ResizeObserver(() => {
      medir();
      if (reducir) renderer.render(escena, camara);
    }).observe(cont);

    // ── Puntero: inclinación suave hacia el cursor ───────────────────────
    const objetivo = { x: 0, y: 0 };
    const puntero = { x: 0, y: 0 };
    if (fino && !reducir) {
      window.addEventListener(
        "pointermove",
        (e) => {
          objetivo.x = (e.clientX / window.innerWidth) * 2 - 1;
          objetivo.y = (e.clientY / window.innerHeight) * 2 - 1;
        },
        { passive: true },
      );
      document.documentElement.addEventListener("mouseleave", () => {
        objetivo.x = 0;
        objetivo.y = 0;
      });
    }

    // ── Bucle ────────────────────────────────────────────────────────────
    let tiempo = 0;
    let anterior = performance.now();
    let visible = true;
    let cuadro = 0;

    const pintar = (ahora: number) => {
      cuadro = 0;
      const dt = Math.min((ahora - anterior) / 1000, 0.05);
      anterior = ahora;
      tiempo += dt;
      puntero.x += (objetivo.x - puntero.x) * 0.05;
      puntero.y += (objetivo.y - puntero.y) * 0.05;

      mundo.rotation.y = tiempo * 0.12 + puntero.x * 0.35;
      mundo.rotation.x = Math.sin(tiempo * 0.25) * 0.08 + puntero.y * 0.25;
      nucleo.rotation.y = -tiempo * 0.2;
      anillos.rotation.y = -tiempo * 0.08 + puntero.x * 0.15;
      anillos.rotation.x = puntero.y * 0.12;
      for (const s of satelites) {
        const a = s.fase + tiempo * s.vel;
        s.malla.position.set(Math.cos(a) * ORBITA, Math.sin(a) * ORBITA, 0);
      }
      renderer.render(escena, camara);
      if (visible && !document.hidden) cuadro = requestAnimationFrame(pintar);
    };
    const arrancar = () => {
      if (cuadro || reducir || !visible || document.hidden) return;
      anterior = performance.now();
      cuadro = requestAnimationFrame(pintar);
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      arrancar();
    }).observe(cont);
    document.addEventListener("visibilitychange", arrancar);

    // ── Entrada: la red crece desde el centro mientras el canvas aparece ──
    cont.setAttribute("data-lista", "");
    if (reducir) {
      renderer.render(escena, camara);
      return;
    }
    gsap.fromTo(mundo.scale, { x: 0.6, y: 0.6, z: 0.6 }, { x: 1, y: 1, z: 1, duration: 1.6, ease: "power3.out" });
    gsap.fromTo(anillos.scale, { x: 0.4, y: 0.4, z: 0.4 }, { x: 1, y: 1, z: 1, duration: 1.8, ease: "power3.out", delay: 0.15 });
    arrancar();
  }

  if (contenedor && canvas) {
    iniciar(contenedor, canvas).catch(() => contenedor.classList.add("escena--sin-webgl"));
  }
</script>

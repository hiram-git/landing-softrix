---
// 3. SELLO DIGITAL: un documento PDF simulado recibe el sello «Certificado por la
// DGI», que cae desde arriba con rebote (ease: bounce.out) al entrar en pantalla.
// Al primer impacto, una onda se expande y el estado del documento pasa a «Aprobado».

// Patrón fijo para el «QR» decorativo (9×9).
const qr = [
  "111111101", "100000101", "101110101", "101110100", "101110111",
  "100000110", "111111101", "000000010", "110101111",
];
---

<section id="facturacion" class="seccion seccion--suave sello" aria-labelledby="sello-titulo" data-sello-seccion>
  <div class="contenedor sello__rejilla">
    <div class="sello__texto g-oculto" data-sello-texto>
      <span class="eyebrow">Facturación electrónica y firma digital</span>
      <h2 id="sello-titulo" class="titulo">Cada factura sale firmada y certificada por la DGI</h2>
      <p class="texto">
        Tu sistema emite el comprobante, el certificado de firma digital lo firma y la DGI lo
        autoriza con su CUFE. Nosotros gestionamos el certificado, la homologación y el soporte
        para que el flujo nunca se detenga.
      </p>
      <ul class="sello__lista">
        <li><strong>Firma electrónica y digital</strong><span>Gestión de certificados con validez legal.</span></li>
        <li><strong>Homologación ante la DGI</strong><span>Alta del contribuyente y pruebas con el PAC.</span></li>
        <li><strong>Soporte continuo</strong><span>Renovaciones, incidencias y cambios normativos.</span></li>
      </ul>
      <a class="btn btn--primario" href="#contacto">Activar facturación electrónica</a>
    </div>

    <div class="sello__escena" aria-hidden="true">
      <div class="doc" data-doc>
        <div class="doc__barra">
          <span class="doc__pdf">PDF</span>
          <span class="doc__nombre">factura-001-00001234.pdf</span>
        </div>
        <div class="doc__hoja">
          <div class="doc__cabecera">
            <div>
              <div class="doc__tipo">Factura electrónica</div>
              <div class="doc__meta">CAFE · N.º 001-00001234</div>
              <div class="doc__meta">Panamá, {new Date().toLocaleDateString("es-PA", { day: "2-digit", month: "long", year: "numeric" })}</div>
            </div>
            <div class="doc__qr">
              {qr.map((fila) => [...fila].map((b) => <i class:list={{ on: b === "1" }} />))}
            </div>
          </div>
          <div class="doc__lineas">
            <span style="width: 92%"></span><span style="width: 70%"></span><span style="width: 84%"></span>
            <span style="width: 58%"></span><span style="width: 76%"></span>
          </div>
          <div class="doc__totales">
            <div><span>Subtotal</span><span>B/. 125.40</span></div>
            <div><span>ITBMS 7 %</span><span>B/. 8.78</span></div>
            <div class="doc__total"><span>Total</span><span>B/. 134.18</span></div>
          </div>
          <div class="doc__cufe">CUFE FE0120000000000-0000000-00000000000000000000000000000000000000A3F9</div>
          <div class="doc__estado" data-doc-estado>Pendiente de autorización</div>
        </div>

        <div class="onda" data-onda></div>
        <div class="stamp" data-stamp>
          <svg viewBox="0 0 200 200" class="stamp__svg">
            <defs>
              <path id="stamp-arco" d="M100 100 m-66 0 a66 66 0 1 1 132 0 a66 66 0 1 1 -132 0" />
            </defs>
            <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="6" />
            <circle cx="100" cy="100" r="82" fill="none" stroke="currentColor" stroke-width="2" />
            <text font-family="Manrope, sans-serif" font-size="15.5" font-weight="800" letter-spacing="2.5" fill="currentColor">
              <textPath href="#stamp-arco" startOffset="25%" text-anchor="middle">CERTIFICADO POR LA DGI</textPath>
            </text>
            <path d="M70 104 l18 18 l42 -46" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
            <text x="100" y="152" text-anchor="middle" font-family="Manrope, sans-serif" font-size="17" font-weight="800" letter-spacing="2" fill="currentColor">APROBADO</text>
            <text x="100" y="170" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" font-weight="600" letter-spacing="3" fill="currentColor">PANAMÁ</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sello__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .sello__texto {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .sello__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .sello__lista li {
    display: grid;
    gap: 2px;
    padding-left: 1rem;
    border-left: 3px solid var(--c-cian);
  }
  .sello__lista strong {
    color: var(--c-marino);
    font-family: var(--f-display);
  }
  .sello__lista span {
    color: var(--c-texto-2);
    font-size: 0.95rem;
  }

  .sello__escena {
    display: grid;
    place-items: center;
    padding-top: 2.5rem; /* espacio por donde cae el sello */
  }
  .doc {
    position: relative;
    width: min(100%, 400px);
    background: #fff;
    border: 1px solid var(--c-borde);
    border-radius: var(--radio);
    box-shadow: var(--sombra-grande);
    overflow: visible;
  }
  .doc__barra {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--c-fondo-2);
    border-bottom: 1px solid var(--c-borde);
    border-radius: var(--radio) var(--radio) 0 0;
    font-size: 0.8rem;
    color: var(--c-texto-2);
  }
  .doc__pdf {
    padding: 3px 7px;
    border-radius: 6px;
    background: var(--c-marino);
    color: #fff;
    font: 700 0.7rem/1 var(--f-texto);
    letter-spacing: 0.06em;
  }
  .doc__hoja {
    padding: 22px 24px 20px;
    display: grid;
    gap: 16px;
  }
  .doc__cabecera {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .doc__tipo {
    font: 800 1.05rem/1.2 var(--f-display);
    color: var(--c-marino);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .doc__meta {
    font-size: 0.78rem;
    color: var(--c-texto-2);
    margin-top: 3px;
  }
  .doc__qr {
    display: grid;
    grid-template-columns: repeat(9, 5px);
    grid-auto-rows: 5px;
    gap: 1px;
    padding: 4px;
    border: 1px solid var(--c-borde);
    border-radius: 4px;
    align-self: start;
  }
  .doc__qr i {
    display: block;
  }
  .doc__qr i.on {
    background: var(--c-marino);
  }
  .doc__lineas {
    display: grid;
    gap: 7px;
  }
  .doc__lineas span {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: #e6ecf3;
  }
  .doc__totales {
    display: grid;
    gap: 5px;
    font-size: 0.85rem;
    color: var(--c-texto-2);
    border-top: 1px dashed var(--c-borde);
    padding-top: 12px;
  }
  .doc__totales div {
    display: flex;
    justify-content: space-between;
  }
  .doc__total {
    color: var(--c-marino);
    font: 800 1rem/1.3 var(--f-display);
  }
  .doc__cufe {
    font: 500 0.66rem/1.4 ui-monospace, Menlo, Consolas, monospace;
    color: var(--c-texto-2);
    overflow-wrap: anywhere;
    padding: 8px 10px;
    background: var(--c-fondo-2);
    border-radius: 6px;
  }
  .doc__estado {
    justify-self: start;
    padding: 5px 10px;
    border-radius: 999px;
    font: 600 0.75rem/1 var(--f-texto);
    background: #fff7ed;
    color: #b45309;
    transition:
      background-color 250ms,
      color 250ms;
  }
  .doc__estado[data-aprobado] {
    background: var(--c-esmeralda-suave);
    color: var(--c-esmeralda);
  }

  /* El sello: tinta esmeralda, ligeramente inclinado, sobre la parte baja del documento. */
  .stamp {
    position: absolute;
    right: -26px;
    bottom: 34px;
    width: 168px;
    height: 168px;
    color: var(--c-esmeralda);
    mix-blend-mode: multiply;
    opacity: 0; /* lo revela GSAP (sin JS queda sin sello; el documento sigue legible) */
    pointer-events: none;
    filter: drop-shadow(0 6px 10px rgba(5, 150, 105, 0.25));
  }
  .stamp__svg {
    width: 100%;
    height: 100%;
  }
  .onda {
    position: absolute;
    right: 32px;
    bottom: 92px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--c-esmeralda-2);
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .sello__rejilla {
      grid-template-columns: 1fr;
    }
    .sello__escena {
      order: -1;
    }
    .stamp {
      right: -8px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const seccion = document.querySelector<HTMLElement>("[data-sello-seccion]");
  if (seccion) {
    const texto = seccion.querySelector<HTMLElement>("[data-sello-texto]");
    const doc = seccion.querySelector<HTMLElement>("[data-doc]");
    const stamp = seccion.querySelector<HTMLElement>("[data-stamp]");
    const onda = seccion.querySelector<HTMLElement>("[data-onda]");
    const estado = seccion.querySelector<HTMLElement>("[data-doc-estado]");
    const reducir = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const aprobar = () => {
      if (!estado) return;
      estado.textContent = "Aprobado por la DGI";
      estado.setAttribute("data-aprobado", "");
    };

    if (reducir) {
      // Sin animación: el sello ya está puesto y el documento, aprobado.
      if (texto) gsap.set(texto, { clearProps: "all" });
      if (stamp) gsap.set(stamp, { autoAlpha: 1, rotation: -12 });
      aprobar();
    } else if (doc && stamp && onda) {
      // bounce.out toca el «papel» por primera vez cerca del 36 % de la duración:
      // ahí se dispara la onda, el documento vibra y el estado cambia.
      const DURACION = 1.25;
      const impacto = DURACION * 0.36;
      const tl = gsap.timeline({ paused: true });
      tl.fromTo(
        stamp,
        { y: -280, autoAlpha: 0, scale: 1.5, rotation: -2 },
        { y: 0, autoAlpha: 1, scale: 1, rotation: -12, duration: DURACION, ease: "bounce.out" },
      )
        .fromTo(
          onda,
          { scale: 0.5, autoAlpha: 0.8 },
          { scale: 2.6, autoAlpha: 0, duration: 0.8, ease: "power2.out" },
          impacto,
        )
        .fromTo(doc, { x: 0 }, { x: 3, duration: 0.05, yoyo: true, repeat: 5, ease: "none" }, impacto)
        .call(aprobar, undefined, impacto + 0.1);

      if (texto) {
        gsap.set(texto, { autoAlpha: 0, y: 32 });
        texto.classList.remove("g-oculto");
        gsap.to(texto, {
          autoAlpha: 1,
          y: 0,
          duration: 0.9,
          ease: "power3.out",
          clearProps: "transform,opacity,visibility",
          scrollTrigger: { trigger: seccion, start: "top 75%", once: true },
        });
      }
      ScrollTrigger.create({
        trigger: doc,
        start: "top 70%",
        once: true,
        onEnter: () => tl.play(),
      });
    }
  }
</script>

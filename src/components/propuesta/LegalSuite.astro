---
// Servicios legales y asesoría fiscal en cuatro tarjetas, y debajo los paneles
// de Equipos y Sector gobierno (contenido de la portada).
const servicios = [
  { titulo: "Firma electrónica y digital", texto: "Gestión de certificados y firma para facturar y contratar con validez legal.", icono: "M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" },
  { titulo: "Asesoría tributaria", texto: "Declaraciones de impuestos, revisión y optimización de cargas fiscales, defensa ante autoridades.", icono: "M4 3h16v18H4z M8 7h8 M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01" },
  { titulo: "Marca y propiedad intelectual", texto: "Registro de marca y protección de tus activos intangibles.", icono: "M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7z" },
  { titulo: "Sociedades y contratos", texto: "Constitución y gestión de sociedades, contratos de compraventa y escrituras en Panamá.", icono: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8M8 17h8" },
];
---

<section id="legal" class="seccion legal" aria-labelledby="legal-titulo">
  <div class="contenedor">
    <div class="cabecera">
      <span class="etiqueta" data-reveal>Servicios legales y asesoría fiscal</span>
      <h2 id="legal-titulo" class="titulo" data-reveal data-reveal-delay="0.2">
        El software viene con <span class="resalte">quien sabe de impuestos</span>
      </h2>
      <p class="texto" data-reveal data-reveal-delay="0.3">
        RC Group acompaña a tu empresa desde la constitución hasta la defensa ante auditorías. La
        facturación electrónica no es solo un sistema: es cumplir bien.
      </p>
    </div>
    <div class="legal__rejilla">
      {
        servicios.map((s, i) => (
          <article class="tarjeta servicio" data-reveal data-reveal-delay={`${0.1 + i * 0.1}`}>
            <span class="icono-redondo" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={s.icono} /></svg>
            </span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </article>
        ))
      }
    </div>
    <div class="legal__accion" data-reveal>
      <a class="boton boton--secundario" href="#contacto">Hablar con un asesor</a>
    </div>

    <div class="paneles">
      <article id="equipos" class="tarjeta tarjeta--suave panel" data-reveal>
        <span class="etiqueta">Equipos</span>
        <h3>Impresoras, lectores y terminales listos para Softrix</h3>
        <p>
          Equipos de facturación electrónica probados con el sistema: impresoras de 80 mm, lectores de
          código y terminales de punto de venta.
        </p>
        <a class="boton boton--secundario boton--chico" href="#contacto">Consultar equipos</a>
      </article>
      <article id="gobierno" class="tarjeta tarjeta--suave panel panel--gobierno" data-reveal data-reveal-delay="0.2">
        <span class="etiqueta etiqueta--azul">Sector gobierno</span>
        <h3>Control de visitantes con verificación de antecedentes</h3>
        <p>
          SmartGate Control para entes públicos: invitaciones, niveles de aprobación y puesto de
          control en tableta.
        </p>
        <a class="boton boton--chico" href="/softrix/smartgate">Ver SmartGate Control</a>
      </article>
    </div>
  </div>
</section>

<style>
  .legal__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .servicio {
    gap: 0.9rem;
  }
  .servicio h3 {
    font-size: 1.3rem;
  }
  .servicio p {
    color: var(--p-gris);
    font-size: 0.95rem;
  }
  .legal__accion {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .paneles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .panel {
    padding: 2.25rem;
    gap: 1rem;
    align-items: flex-start;
  }
  .panel h3 {
    font-size: 1.6rem;
  }
  .panel p {
    color: var(--p-gris);
    flex: 1;
  }
  .panel--gobierno {
    background: var(--p-azul-suave);
  }
  .panel--gobierno .boton {
    background: linear-gradient(0deg, #2360aa, #4a8ee0);
  }
  .etiqueta--azul {
    color: var(--p-azul);
  }
</style>

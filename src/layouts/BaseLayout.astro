---
import "@/styles/global.css";
import BotonWhatsApp from "@/components/BotonWhatsApp.astro";
import Cabecera from "@/components/Cabecera.astro";
import Pie from "@/components/Pie.astro";
import { sitio } from "@/config/site";

interface Props {
  titulo?: string;
  descripcion?: string;
}
const { titulo, descripcion = sitio.descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · Software de gestión hecho para Panamá`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={sitio.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#0b0808" />
    {sitio.marcadores && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PA" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />

    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      // Antes del primer pintado: evita el destello del tema equivocado.
      (() => {
        let tema = null;
        try {
          tema = localStorage.getItem("softrix.tema");
        } catch {}
        if (tema !== "light" && tema !== "dark") {
          tema = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = tema;
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <BotonWhatsApp />
  </body>
</html>

---
import Letrero from "@/components/Letrero.astro";
import RutaProductos from "@/components/RutaProductos.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout titulo="Página no encontrada">
  <section class="perdido pintura" aria-labelledby="perdido-titulo">
    <div class="contenedor perdido__rejilla">
      <Letrero destinos={["FUERA DE RUTA"]} tamano="medio" class="perdido__letrero" />
      <div>
        <h1 id="perdido-titulo">Esta página no está en la ruta.</h1>
        <p>Puede que el enlace haya cambiado. Estas son nuestras paradas:</p>
      </div>
      <RutaProductos />
      <a class="boton boton--cromo" href="/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .perdido {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .perdido__rejilla {
    display: grid;
    gap: 2.25rem;
    justify-items: start;
  }
  .perdido__letrero {
    width: 100%;
    max-width: 36rem;
  }
  .perdido h1 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }
  .perdido p {
    margin-top: 1rem;
    color: var(--sobre-pintura-2);
    font-size: 1.125rem;
  }
</style>

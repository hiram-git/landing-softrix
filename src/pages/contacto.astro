---
import Icono from "@/components/Icono.astro";
import { enlaceWhatsApp, productos, sitio } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  titulo="Solicitar cotización"
  descripcion="Pide una cotización de Softrix Facturación, Softrix Planilla o Softrix Control de Entrada."
>
  <section class="contacto pintura pintura--quieta" aria-labelledby="contacto-titulo">
    <div class="contenedor contacto__rejilla">
      <div class="contacto__texto">
        <h1 id="contacto-titulo">Solicita tu cotización.</h1>
        <p>
          Cada cotización se arma según tus sucursales, usuarios y módulos. Escríbenos y te
          respondemos con una propuesta y una demostración.
        </p>
        <p class="contacto__producto" data-producto-elegido hidden></p>
      </div>

      <ul class="contacto__canales">
        <li>
          <a class="canal" href={enlaceWhatsApp()} target="_blank" rel="noopener" data-canal-whatsapp>
            <Icono nombre="whatsapp" />
            <span>
              <strong>WhatsApp</strong>
              <span>{sitio.whatsapp.visible}</span>
            </span>
          </a>
        </li>
        <li>
          <a class="canal" href={`mailto:${sitio.correo}`} data-canal-correo>
            <Icono nombre="correo" />
            <span>
              <strong>Correo</strong>
              <span>{sitio.correo}</span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ productos, numero: sitio.whatsapp.numero, correo: sitio.correo }}>
  // ?producto=slug llega desde los botones de cada página de producto.
  const slug = new URLSearchParams(location.search).get("producto");
  const producto = productos.find((p) => p.slug === slug);
  if (producto) {
    const aviso = document.querySelector("[data-producto-elegido]");
    aviso.textContent = `Producto: ${producto.nombre}`;
    aviso.hidden = false;
    const mensaje = `Hola, quiero una cotización de ${producto.nombre}.`;
    document.querySelector("[data-canal-whatsapp]").href =
      `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
    document.querySelector("[data-canal-correo]").href =
      `mailto:${correo}?subject=${encodeURIComponent(`Cotización de ${producto.nombre}`)}`;
  }
</script>

<style>
  .contacto {
    padding-block: clamp(3.5rem, 9vw, 7rem);
    min-height: 60svh;
  }

  .contacto__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .contacto h1 {
    font-size: clamp(2.3rem, 5vw, 4rem);
  }

  .contacto__texto p {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--sobre-pintura-2);
    font-size: 1.125rem;
  }

  .contacto .contacto__producto {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--cabina);
    color: var(--cabina-tinta);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .contacto__canales {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .canal {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    border-radius: var(--radio-grande);
    background: rgb(246 245 245 / 0.06);
    box-shadow: 0 0 0 1.5px var(--hilo-pintura) inset;
    color: var(--sobre-pintura);
    text-decoration: none;
    transition: box-shadow var(--dur-corta) ease, background-color var(--dur-corta) ease;
  }

  .canal:hover {
    background: rgb(246 245 245 / 0.1);
    box-shadow: 0 0 0 1.5px var(--cromo-claro) inset;
  }

  .canal :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    color: var(--cabina);
  }

  .canal > span {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .canal strong {
    font-size: 1.1rem;
  }

  .canal span span {
    color: var(--sobre-pintura-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .contacto__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>

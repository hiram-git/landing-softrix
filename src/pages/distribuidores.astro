---
import Cierre from "@/components/Cierre.astro";
import Letrero from "@/components/Letrero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const puntos = [
  {
    titulo: "Tu propio panel",
    texto: "Consulta tus licencias, sus clientes y sus vencimientos en un solo lugar.",
  },
  {
    titulo: "Licencias por paquete",
    texto: "Compra paquetes de licencias y asígnalas a tus clientes cuando cierres cada venta.",
  },
  {
    titulo: "Renovaciones a tiempo",
    texto: "Recibe avisos antes de cada vencimiento y renueva sin que tu cliente se quede sin servicio.",
  },
];
---

<BaseLayout
  titulo="Distribuidores"
  descripcion="Programa de distribuidores de Softrix para revendedores e integradores de software."
>
  <section class="cabeza pintura" aria-labelledby="dist-titulo">
    <div class="contenedor cabeza__rejilla">
      <Letrero destinos={["DISTRIBUIDORES"]} tamano="medio" class="cabeza__letrero" />
      <div class="cabeza__texto">
        <h1 id="dist-titulo">Vende Softrix a tus clientes.</h1>
        <p>
          Si eres revendedor o integrador, puedes ofrecer Facturación, Planilla y Control de Entrada
          con tu propio panel de licencias.
        </p>
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="dist-como">
    <div class="contenedor">
      <h2 id="dist-como" class="titulo">Cómo funciona</h2>
      <dl class="puntos">
        {
          puntos.map((p) => (
            <div>
              <dt>{p.titulo}</dt>
              <dd>{p.texto}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Cierre
    titulo="Hablemos de tu cartera de clientes."
    texto="Cuéntanos en qué país operas y a qué clientes atiendes, y te enviamos las condiciones del programa."
  />
</BaseLayout>

<style>
  .cabeza {
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .cabeza__rejilla {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .cabeza__letrero {
    max-width: 40rem;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.1rem;
    max-width: 50rem;
  }
  .cabeza h1 {
    font-size: clamp(2.1rem, 4.8vw, 4rem);
  }
  .cabeza__texto p {
    max-width: 50ch;
    font-size: 1.15rem;
    color: var(--sobre-pintura-2);
  }
  .titulo {
    font-size: clamp(1.8rem, 3.6vw, 2.75rem);
    margin-bottom: 2.5rem;
  }
  .puntos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0 clamp(2rem, 5vw, 4rem);
    margin: 0;
  }
  .puntos > div {
    padding-top: 1.4rem;
    border-top: 2px solid var(--tinta);
    padding-bottom: 1.5rem;
  }
  .puntos dt {
    font-family: var(--f-display);
    font-stretch: 112%;
    font-weight: 750;
    font-size: 1.2rem;
  }
  .puntos dd {
    margin: 0.55rem 0 0;
    color: var(--tinta-2);
  }
</style>

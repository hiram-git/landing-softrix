---
/*
  Contrato de dirección «Ruta Softrix» (registrado en DESIGN.md):
  THESIS: Softrix es una ruta, no un catálogo. La portada es el letrero de destino
  de un diablo rojo que anuncia a dónde lleva la suite; se rechaza el hero SaaS de
  degradado + captura flotante + tres tarjetas iguales.
  OWN-WORLD: carrocería negra con rojo del logo aerografiado y grano; cromo en marcos,
  bordes y filetes con remate en espiral; letra de rótulo (Bungee) en amarillo de
  cabina con sombra roja desplazada; Archivo ancho para titulares, Inter para leer;
  papel blanco limpio para el contenido.
  STORY: el visitante entiende que es software de gestión hecho para Panamá, ve los
  tres destinos y toma su parada o pide cotización.
  FIRST VIEWPORT: letrero de ruta a todo el ancho rotando los tres destinos; debajo,
  a la izquierda titular y botón amarillo «Solicitar cotización», a la derecha la
  línea de ruta vertical con las tres paradas sincronizada con el letrero.
*/
import Filete from "@/components/Filete.astro";
import Icono from "@/components/Icono.astro";
import Letrero from "@/components/Letrero.astro";
import RutaProductos from "@/components/RutaProductos.astro";
import { enlaceWhatsApp, productos } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section
    class="portada pintura"
    data-zona-letrero
    data-oculta-wa
    aria-labelledby="portada-titulo"
  >
    <div class="contenedor portada__rejilla">
      <Letrero
        destinos={productos.map((p) => p.destino)}
        rotar
        tamano="grande"
        id="letrero-portada"
        class="portada__letrero"
      />

      <div class="portada__texto">
        <h1 id="portada-titulo">Software de gestión hecho para Panamá.</h1>
        <p class="portada__bajada">
          Factura ante la DGI, paga tu planilla y controla quién entra a tu edificio. Una sola
          suite para todas tus sucursales, en la nube o instalada en tu local.
        </p>
        <div class="portada__acciones">
          <a class="boton boton--cabina" href="/contacto">Solicitar cotización</a>
          <a class="boton boton--cromo" href={enlaceWhatsApp()} target="_blank" rel="noopener">
            <Icono nombre="whatsapp" />
            Escríbenos por WhatsApp
          </a>
        </div>
        <div class="portada__filete" aria-hidden="true">
          <Filete />
        </div>
      </div>

      <div class="portada__ruta">
        <h2 class="portada__ruta-titulo">Elige tu parada</h2>
        <RutaProductos sincroniza="letrero-portada" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .portada {
    overflow: hidden;
    min-height: calc(100svh - var(--alto-cabecera));
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 4.5vw, 3.5rem);
  }

  .portada__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-areas:
      "letrero letrero"
      "texto ruta";
    gap: clamp(2rem, 4vw, 3.25rem) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .portada__letrero {
    grid-area: letrero;
  }

  .portada__texto {
    grid-area: texto;
    display: grid;
    gap: 1.25rem;
  }

  .portada__ruta {
    grid-area: ruta;
    padding-top: 0.75rem;
  }

  .portada h1 {
    font-size: clamp(2.35rem, 5.2vw, 4.5rem);
    font-stretch: 122%;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .portada__bajada {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: var(--sobre-pintura-2);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .portada__filete {
    max-width: 24rem;
    margin-top: 1.25rem;
  }

  .portada__ruta-titulo {
    font-family: var(--f-letrero);
    font-weight: 400;
    font-stretch: 100%;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--cromo-claro);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 899.98px) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "letrero"
        "texto"
        "ruta";
    }
    .portada__filete {
      display: none;
    }
    .portada__ruta {
      padding-top: 0;
    }
  }
</style>

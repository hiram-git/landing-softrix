---
import Filete from "@/components/Filete.astro";
import Icono from "@/components/Icono.astro";
import Letrero from "@/components/Letrero.astro";
import RutaProductos from "@/components/RutaProductos.astro";
import { enlaceWhatsApp, productos } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <Fragment set:html={`<!--
    THESIS: Softrix es una ruta, no un catálogo. La portada es el letrero de
    destino de un diablo rojo que anuncia a dónde lleva la suite; se rechaza el
    hero SaaS de degradado azul + captura flotante + tres tarjetas iguales.
    OWN-WORLD: carrocería negra con rojo del logo aerografiado y grano; cromo en
    marcos y filetes con remate en espiral; letra de rótulo (Bungee) en amarillo
    de cabina con sombra roja desplazada; Archivo ancho para titulares, Inter
    para leer; papel blanco limpio para el contenido.
    STORY: el visitante entiende que es software de gestión hecho para Panamá,
    ve los tres destinos y toma su parada o pide cotización.
    FIRST VIEWPORT: letrero de ruta a todo el ancho rotando FACTURACIÓN ·
    PLANILLA · CONTROL DE ENTRADA; debajo, titular y botón amarillo
    «Solicitar cotización»; al pie, la línea de ruta con las tres paradas.
    FORM: Ruta Softrix (diablo rojo), candidato 4 de 7, seed 9cb66914 degradado.
  -->`} />
  <section class="portada pintura" data-zona-letrero aria-labelledby="portada-titulo">
    <div class="portada__filetes" aria-hidden="true">
      <Filete class="portada__filete portada__filete--der" voltear />
    </div>

    <div class="contenedor portada__rejilla">
      <Letrero
        destinos={productos.map((p) => p.destino)}
        rotar
        tamano="grande"
        id="letrero-portada"
        class="portada__letrero"
      />

      <div class="portada__texto">
        <h1 id="portada-titulo">Software de gestión hecho para Panamá.</h1>
        <p class="portada__bajada">
          Factura ante la DGI, paga tu planilla y controla quién entra a tu edificio. Una sola
          suite para todas tus sucursales, en la nube o instalada en tu local.
        </p>
        <div class="portada__acciones">
          <a class="boton boton--cabina" href="/contacto">Solicitar cotización</a>
          <a class="boton boton--cromo" href={enlaceWhatsApp()} target="_blank" rel="noopener">
            <Icono nombre="whatsapp" />
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>

      <div class="portada__ruta">
        <h2 class="portada__ruta-titulo">Elige tu parada</h2>
        <RutaProductos orientacion="horizontal" sincroniza="letrero-portada" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .portada {
    overflow: hidden;
    min-height: calc(100svh - var(--alto-cabecera));
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .portada__filetes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .portada__filete {
    position: absolute;
    width: min(30rem, 42vw);
    opacity: 0.85;
  }

  .portada__filete--der {
    right: -6rem;
    bottom: 1.5rem;
  }

  .portada__rejilla {
    display: grid;
    gap: clamp(2rem, 4.5vw, 3.5rem);
  }

  .portada__letrero {
    position: relative;
    z-index: 1;
  }

  .portada__texto {
    display: grid;
    gap: 1.25rem;
    max-width: 50rem;
  }

  .portada h1 {
    font-size: clamp(2.35rem, 5.6vw, 4.75rem);
    font-stretch: 122%;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .portada__bajada {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: var(--sobre-pintura-2);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .portada__ruta {
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  .portada__ruta-titulo {
    font-family: var(--f-letrero);
    font-weight: 400;
    font-stretch: 100%;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--cromo-claro);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .portada__filetes {
      display: none;
    }
  }
</style>

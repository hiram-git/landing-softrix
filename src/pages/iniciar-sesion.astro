---
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import { productos } from "@/data/productos";
import Base from "@/layouts/Base.astro";

const conAcceso = productos.flatMap((p) => (p.acceso ? [{ ...p, acceso: p.acceso }] : []));
---

<Base
  title="Iniciar sesión · RCG Softrix"
  description="Entra a Softrix Facturación o a Softrix RRHH. Cada producto tiene su propio acceso."
  seccion="acceso"
  topBar={false}
  footer="compacto"
>
  <section class="seccion acceso" data-theme="dark" aria-labelledby="acceso-titulo">
    <div class="contenedor pila">
      <div class="encabezado">
        <div class="eyebrow">Iniciar sesión</div>
        <h1 id="acceso-titulo" class="titulo-seccion">¿A qué sistema quieres entrar?</h1>
        <p class="texto-apoyo">
          Cada producto tiene su propio acceso. Entra con el usuario y la contraseña que te dio tu
          empresa.
        </p>
      </div>

      <ul class="acceso__rejilla" role="list">
        {
          conAcceso.map((p) => (
            <li>
              <article class="sx-card acceso__tarjeta">
                <div class="sx-card__media">
                  <img
                    src={`${p.captura.base}-640.webp`}
                    srcset={`${p.captura.base}-640.webp 640w, ${p.captura.base}-1280.webp ${p.captura.anchoGrande}w`}
                    sizes="(max-width: 959.98px) calc(100vw - 32px), 560px"
                    alt=""
                    width="640"
                    height="400"
                    decoding="async"
                  />
                </div>
                <div class="sx-card__eyebrow">{p.eyebrow}</div>
                <h2 class="sx-card__title">{p.title}</h2>
                <p class="acceso__host">{new URL(p.acceso).host}</p>
                <div class="sx-card__footer">
                  {/* En la misma pestaña: es la puerta del sistema, no un enlace de consulta. */}
                  <a class="sx-btn sx-btn--primary" href={p.acceso}>
                    Entrar a {p.title}
                    <Icon name="arrow" class="sx-btn__flecha" />
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>

      <p class="acceso__nota">
        ¿Todavía no usas RCG Softrix?
        <Button variant="ghost" href="/#demo" arrow>Solicitar demo</Button>
      </p>
    </div>
  </section>
</Base>

<style>
  .acceso {
    min-height: 60vh;
  }
  .acceso__rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .acceso__rejilla > li {
    display: flex;
    min-width: 0;
  }
  .acceso__tarjeta {
    flex: 1;
  }
  .acceso__host {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .acceso__nota {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    color: var(--ink-muted);
  }
  @media (max-width: 959.98px) {
    .acceso__rejilla {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
